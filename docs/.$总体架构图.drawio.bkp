        <!-- ============ 框架边界 ============ -->
        <mxCell id="fwRegion" value="通用框架：通信 · 调度 · 生命周期 —— 不含业务逻辑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;fontSize=12;fontStyle=1;fontColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
