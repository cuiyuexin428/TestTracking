<mxfile host="app.diagrams.net" agent="kimi-code" version="24.7.5" type="device">
  <diagram id="arch" name="总体架构图">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 标题 -->
        <mxCell id="title" value="stp-test-tracking 总体架构与任务流" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="8" width="500" height="28" as="geometry" />
