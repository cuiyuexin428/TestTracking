{
  "schema_version": 1,
  "plugin": "stpcompare",
  "title": "STP 原始结果",
  "description": "展示新旧程序四份 info 原始结果的入库完整性。",
  "primary_metric": {
    "label": "完整入库",
    "value": "analysis.complete",
    "format": "integer",
    "suffix": " 个文件",
    "tone": "success",
    "empty": "--"
  },
  "widgets": [
    {
      "id": "ingestion_summary",
      "type": "metrics",
      "title": "原始数据",
      "items": [
        {"label": "完整文件", "value": "analysis.complete", "format": "integer", "tone": "success"},
        {"label": "不完整文件", "value": "analysis.incomplete", "format": "integer", "tone": "danger"},
        {"label": "原始输出", "value": "analysis.raw_outputs", "format": "integer", "tone": "neutral"}
      ]
    }
  ],
  "empty_states": {
    "pending": "等待 stpcompare 后处理结果。",
    "error": "stpcompare 后处理结果读取失败，请检查结果服务日志。",
    "not_configured": "stpcompare 后处理表尚未配置。",
    "not_selected": "请选择一个 stpcompare 运行。"
  }
}
